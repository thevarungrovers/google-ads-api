# =============================================================================
# Google Ads API — Phase 1 (read-only reporting)
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit real values, and never paste them into a
# commit message, a log line or an issue.
#
# Optional keys below are spelled out with EMPTY values on purpose, so this
# file documents everything that can be configured. That is safe here because
# every setting is read through googleads_reporting.config.env(), which treats
# "present but blank" exactly like "absent" and falls back to the code default.
# =============================================================================

# --- Required: developer token -----------------------------------------------
# Google Ads UI (on the MCC) > Tools & Settings > Setup > API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Required: OAuth2 client (Desktop app) -----------------------------------
# Google Cloud Console > APIs & Services > Credentials > Create credentials
#   > OAuth client ID > Application type: Desktop app
# Enable the "Google Ads API" on the same project first.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- Required: refresh token --------------------------------------------------
# Generated once, locally, by:
#   ./.venv/bin/python scripts/generate_refresh_token.py
# It does not expire unless revoked or unused for 6 months.
GOOGLE_ADS_REFRESH_TOKEN=

# --- Required: the manager account (MCC) the calls are made through ----------
# 10 digits. Dashes are fine — they are stripped automatically.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Optional: default account to report on ----------------------------------
# The Google Ads account to report on, under the MCC above. Leave blank to be
# forced to pass --customer-id explicitly on every command.
GOOGLE_ADS_CUSTOMER_ID=

# --- Optional: overrides (blank = use the code default) ----------------------
# API version bundled with google-ads 33.0.0: v23, v24, v25. Default: v25.
GOOGLE_ADS_API_VERSION=
# Where exported reports are written. Default: output/ (gitignored).
GOOGLE_ADS_OUTPUT_DIR=
