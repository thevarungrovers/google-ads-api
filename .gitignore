# ---- Secrets: never commit ----
.env
# Three patterns, because none covers the others: `.env` is the exact name,
# `.env.*` catches .env.local / .env.production, and `*.env` catches
# staging.env. The negation must come last to survive them all.
.env.*
*.env
!.env.example
client_secret*.json
token*.json
# Broad on purpose: a stored refresh token must never slip in under any name.
# It also matches the generator SCRIPT, which is source, so re-include that.
*refresh_token*
!scripts/generate_refresh_token.py
*.pem

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Generated reports / exports ----
data/
output/

# ---- Mutation audit logs: account data, and they are the local record ----
audit/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
